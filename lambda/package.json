{
  "name": "visual-qa-inspector-lambda",
  "version": "1.0.0",
  "description": "Lambda orchestrator for VisualQA Inspector — routes analysis requests to Bedrock",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "zip -r lambda.zip src/ node_modules/ package.json"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.600.0",
    "@aws-sdk/client-dynamodb": "3.600.0",
    "@aws-sdk/client-s3": "3.600.0",
    "@aws-sdk/s3-request-presigner": "3.600.0",
    "ajv": "8.16.0",
    "sharp": "0.33.4",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "@types/node": "20.14.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js"]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
