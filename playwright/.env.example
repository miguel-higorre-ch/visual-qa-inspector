# VisualQA Inspector – Playwright Capture Module
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── AWS Credentials ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_REGION=us-east-1

# Optional: only needed when using temporary STS credentials
# AWS_SESSION_TOKEN=your_session_token_here

# ── S3 Configuration ───────────────────────────────────────────────────────────
S3_BUCKET_NAME=visual-qa-inspector-images

# ── Target URLs ────────────────────────────────────────────────────────────────
# URL of the baseline version of your application
BASELINE_URL=http://localhost:3000

# URL of the current (under-review) version of your application
CURRENT_URL=http://localhost:3001
